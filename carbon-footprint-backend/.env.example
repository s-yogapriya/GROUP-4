# Copy this file to .env and fill in your local PostgreSQL & Mail credentials

# PostgreSQL Database Credentials
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/carbonfootprint
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password

# Mail Credentials for Password Dispatch (Gmail App Password)
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_app_password

# Google OAuth2 (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth2
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
APP_FRONTEND_URL=http://localhost:5173

# Custom JWT & Admin Account
APP_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250655368566D5971
APP_ADMIN_EMAIL=admin@infosys.com
APP_ADMIN_PASSWORD=admin123
